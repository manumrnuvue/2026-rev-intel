# ── Azure OpenAI (Nova chat widget) ──────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ── Contact / demo form email (Resend) ────────────────────────────
RESEND_API_KEY=re_your_api_key_here

# Where demo requests are delivered (internal — never shown on the site).
CONTACT_TO=manu@nuvae.ai
CONTACT_FROM=Nuvae Website <no-reply@nuvae.ai>

# ── Daily Nova chat-interaction digest (app/api/cron/chat-digest) ────────
# Nova chat widget is unmounted (replaced by Tawk.to) but this cron/backend is
# left in place — still uses SMTP via Nodemailer if re-enabled.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false            # true for port 465
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Where the digest email of every chat interaction that day is sent. Falls
# back to CONTACT_TO if unset.
CHATLOG_TO=manu@nuvae.ai

# Required to authorize calls to /api/cron/chat-digest. On Vercel, set this
# project env var and Vercel Cron automatically sends it as
# `Authorization: Bearer <CRON_SECRET>` — no need to put it in vercel.json.
# For manual/local testing: curl "http://localhost:5180/api/cron/chat-digest?secret=<CRON_SECRET>"
CRON_SECRET=a-long-random-string
